{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 45,
  "autoUpdatesChannel": "stable",
  "theme": "dark",
  "skillOverrides": {
    "graphify": "off"
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "statusline.sh",
    "padding": 0
  }
}