{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoUpdatesChannel": "stable",
  "theme": "dark",
  "permissions": {
    "defaultMode": "manual",
    "disableAutoMode": "disable"
  },
  "cleanupPeriodDays": 45,
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/statusline.py",
    "padding": 0
  }
}